#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

1 24 "app.manifest"

IDI_APP ICON "app.ico"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_MAIN DIALOGEX 0, 0, 620, 380
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP |
      WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "网卡管理工具"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    PUSHBUTTON "网卡配置",   IDC_NAV_NIC,   7,  7, 80, 22, BS_OWNERDRAW
    PUSHBUTTON "系统路由表", IDC_NAV_ROUTE, 7, 32, 80, 22, BS_OWNERDRAW
    PUSHBUTTON "网络测试",   IDC_NAV_TEST,  7, 57, 80, 22, BS_OWNERDRAW

    PUSHBUTTON "启用",           IDC_ENABLE,    95,  7, 45, 14, WS_DISABLED
    PUSHBUTTON "禁用",           IDC_DISABLE,   142, 7, 45, 14, WS_DISABLED
    PUSHBUTTON "配置...",        IDC_CONFIG,    189, 7, 45, 14, WS_DISABLED
    PUSHBUTTON "详细",           IDC_DETAIL,    236, 7, 45, 14
    PUSHBUTTON "刷新",           IDC_REFRESH,   283, 7, 45, 14
    PUSHBUTTON "刷新 DNS 缓存",  IDC_FLUSH_DNS, 330, 7, 72, 14
    PUSHBUTTON "重置网络",       IDC_RESET,     404, 7, 55, 14
    CONTROL "", IDC_LIST, "SysListView32",
        LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
        95, 26, 518, 334

    PUSHBUTTON "刷新",       IDC_ROUTE_REFRESH, 95,  7, 45, 14
    PUSHBUTTON "添加路由",   IDC_ROUTE_ADD,     142, 7, 55, 14
    PUSHBUTTON "删除路由",   IDC_ROUTE_DEL,     199, 7, 55, 14, WS_DISABLED
    CONTROL "", IDC_ROUTE_LIST, "SysListView32",
        LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
        95, 26, 518, 334

    RTEXT "目标", IDC_TEST_LABEL, 95, 10, 30, 8
    EDITTEXT IDC_TEST_TARGET, 128, 8, 190, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_TEST_KIND, 324, 8, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON "开始", IDC_TEST_RUN, 400, 8, 45, 14
    EDITTEXT IDC_TEST_OUT, 95, 26, 518, 334,
        ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER

    CONTROL "", IDC_STATUSBAR, "msctls_statusbar32", WS_CHILD | WS_VISIBLE, 0, 0, 0, 0
END

IDD_DETAIL DIALOGEX 0, 0, 240, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "网卡详细信息"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END
