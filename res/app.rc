#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

1 24 "app.manifest"

IDI_APP ICON "app.ico"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_MAIN DIALOGEX 0, 0, 620, 380
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP |
      WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "网卡管理工具"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    PUSHBUTTON "启用",           IDC_ENABLE,    5,   5, 45, 14, WS_DISABLED
    PUSHBUTTON "禁用",           IDC_DISABLE,   52,  5, 45, 14, WS_DISABLED
    PUSHBUTTON "刷新",           IDC_REFRESH,   99,  5, 45, 14
    PUSHBUTTON "刷新 DNS 缓存",  IDC_FLUSH_DNS, 146, 5, 72, 14
    PUSHBUTTON "详细信息",       IDC_DETAIL,    220, 5, 50, 14
    CONTROL "", IDC_LIST, "SysListView32",
        LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
        5, 24, 610, 320
    CONTROL "", IDC_STATUSBAR, "msctls_statusbar32", WS_CHILD | WS_VISIBLE, 0, 0, 0, 0
END

IDD_DETAIL DIALOGEX 0, 0, 240, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "网卡详细信息"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END
